# Proxy to the sync Worker: keeps the client on the same origin so mobile
# carriers that filter *.workers.dev cannot break syncing (SPEC §11 spirit).
# Must come before the SPA fallback.
/api/* https://cacotas-sync.soker.workers.dev/:splat 200

# SPA fallback: any deep link (/settings, /inventory/2, …) serves the shell.
# Existing files (assets, icons) take precedence over this rule.
/*    /index.html   200
