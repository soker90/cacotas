# Variables del frontend.
# Copia este archivo a .env y rellena los valores necesarios.
# Los valores VITE_* se incorporan al bundle durante el build:
# no los trates como secretos.

# URL base del Worker de sincronización.
VITE_SYNC_URL=https://cacotas-sync.example.workers.dev

# Client ID de Google Identity Services.
VITE_GOOGLE_CLIENT_ID=

# Clave pública VAPID para Web Push.
VITE_VAPID_PUBLIC_KEY=

# Opcional: DSN de Sentry para errores del frontend.
VITE_SENTRY_DSN=